<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_production" model="ir.module.category">
            <field name="name">Production</field>
            <field name="description">Category for production-related modules</field>
        </record>

        <record id="group_production_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_production"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                The user can create and edit their own daily production entries and view orders and lots.
            </field>
        </record>

        <record id="group_production_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_production"/>
            <field name="implied_ids" eval="[(4, ref('group_production_user'))]"/>
            <field name="comment">
                The manager can create and manage production orders, generate reports, and administer lots.
            </field>
        </record>

        <record id="production_daily_user_rule" model="ir.rule">
            <field name="name">Daily Production User Rule</field>
            <field name="model_id" ref="model_production_daily"/>
            <field name="groups" eval="[(4, ref('group_production_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>
    </data>
</odoo>
